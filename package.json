{
  "name": "cuckoo-code",
  "version": "0.1.4",
  "description": "DeepSeek 桌面应用——内嵌浏览器，自动识别 AI 回复中的命令和工具调用并执行",
  "main": "main.js",
  "scripts": {
    "start": "chcp 65001 > nul && electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "electron-builder --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:win:nsis": "electron-builder --win --config.win.target=nsis --publish never",
    "build:win:portable": "electron-builder --win --config.win.target=portable --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:mac:dmg": "electron-builder --mac --config.mac.target=dmg --publish never"
  },
  "keywords": [
    "deepseek",
    "electron",
    "ai",
    "cli",
    "command-execution",
    "developer-tools",
    "cuckoo-code"
  ],
  "author": {
    "name": "Cuckoo Code Contributors",
    "url": "https://github.com/wangyongpeng90/cuckoo-code"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangyongpeng90/cuckoo-code.git"
  },
  "bugs": {
    "url": "https://github.com/wangyongpeng90/cuckoo-code/issues"
  },
  "homepage": "https://github.com/wangyongpeng90/cuckoo-code#readme",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "build": {
    "appId": "com.cuckoo.cuckoo-code",
    "productName": "Cuckoo-Code",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "cuckoo-code-win-v${version}.${ext}"
    },
    "portable": {
      "artifactName": "cuckoo-code-win-v${version}-portable.${ext}"
    },
    "files": [
      "**/*",
      "!node_modules/.bin",
      "!dist",
      "!build",
      "!*.md",
      "!LICENSE"
    ],
    "extraResources": [
      {
        "from": "tools",
        "to": "tools",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
